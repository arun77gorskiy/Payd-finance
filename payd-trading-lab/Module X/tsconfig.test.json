{
  "compilerOptions": {
    "target": "es2017",
    "module": "commonjs",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowJs": true,
    "noEmitOnError": false,
    "rootDir": "..",
    "types": ["node"]
  },
  "include": [
    "analyzers/*.ts",
    "tests/*.ts"
  ]
}
