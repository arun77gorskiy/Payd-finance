# ==============================================================================
# PAYD INTELLIGENCE - Environment Variables (TEMPLATE)
# ==============================================================================
# Copy this file to `.env` and fill in your actual values.
# NEVER commit your real `.env` file — it is already excluded by .gitignore.
# ==============================================================================

# ----- DATA PROVIDERS (Server-side, used by the enrichment pipeline) ----------

# CoinGecko Demo API key (optional, increases rate limits)
# Get one at https://www.coingecko.com/en/api/pricing
COINGECKO_API_KEY=

# CoinGlass Pro API key (optional, derivatives market data)
# Get one at https://www.coinglass.com/api
COINGLASS_API_KEY=

# GitHub Personal Access Token (optional, raises GitHub API rate limit)
# Create at https://github.com/settings/tokens
GITHUB_TOKEN=

# DefiLlama does not require a key for basic access
# DEFILlAMA_API_KEY=

# ----- FEATURE FLAGS ----------------------------------------------------------

# Enable CoinGlass derivatives intelligence (true|false)
# When false, the provider returns AUTH_REQUIRED and is fully isolated
COINGLASS_ENABLED=false

# Enable background scheduler for periodic enrichment
SCHEDULER_ENABLED=true

# ----- STORAGE / DATABASE -----------------------------------------------------

# Supabase project (used by deployed version)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ----- DEPLOYMENT -------------------------------------------------------------

# Base URL of the deployed site (used for canonical links, OG tags)
PUBLIC_SITE_URL=https://rywl601uh730.space.mcode.io

# Node environment
NODE_ENV=production

# ==============================================================================
# Notes
# ==============================================================================
# - All keys are read by the Node enrichment scripts in `code/providers/`
# - All keys are read server-side; nothing is shipped to the browser bundle
# - The frontend reads only pre-computed JSON from `public/data/`
# - CoinGlass, when `COINGLASS_ENABLED=false`, is a no-op — see code/providers/coinglass.js
# ==============================================================================
